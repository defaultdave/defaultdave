{
  "name": "defaultdave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p .storybook",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "e2e": "playwright test --trace off",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry -o node_modules/.cache/storybook-static"
  },
  "dependencies": {
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@mdx-js/mdx": "3.1.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@storybook/nextjs-vite": "10.6.6",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@joshwooding/vite-plugin-react-docgen-typescript>glob": "^14.0.2"
    }
  }
}
